FROM nginx:1.28-alpine

COPY frontend/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY frontend/src/index.html /usr/share/nginx/html/index.html
COPY frontend/src/icons /usr/share/nginx/html/src/icons
COPY frontend/src/manifest.json /usr/share/nginx/html/src/manifest.json
COPY frontend/src/style.css /usr/share/nginx/html/src/style.css

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --spider -q http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
