MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=recipes
MYSQL_USER=recipes

SECRET_KEY=change-me

DATABASE_URL=mysql+mysqlconnector://recipes:change-me@mysql:${MYSQL_PORT:-3306}/recipes

MEDIA_ROOT=/media
PUBLIC_URL=
ALLOWED_HOSTS=localhost,127.0.0.1,backend,*.ts.net

WHISPER_MODEL=tiny

# Port configuration (override for internal networking)
FRONTEND_PORT=3000
BACKEND_PORT=8000
MYSQL_PORT=3306

# CORS / TrustedHost (comma-separated)
# Use "*" to allow all origins/hosts (behind a reverse proxy)
ALLOWED_ORIGINS=*
ALLOWED_HOSTS=*

# SMTP / outbound email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Default admin bootstrap (change immediately after first deploy)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
DEFAULT_ADMIN_DISPLAY_NAME=Admin

# Optional: use GHCR images instead of local Docker build.
# Requires a GitHub PAT with read:packages when the repo/image is private.
BACKEND_IMAGE="ghcr.io/wickedyoda/recipe-app-backend:latest"
FRONTEND_IMAGE="ghcr.io/wickedyoda/recipe-app-frontend:latest"
BACKEND_PULL_POLICY=always
FRONTEND_PULL_POLICY=always
